{
  "name": "piarium",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A native workspace for Pi agents.",
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "@google/genai": false,
    "electron@43.2.0": true,
    "esbuild@0.28.1": true,
    "protobufjs": false
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @piarium/protocol && npm run build --workspace @piarium/pi-host && npm run build --workspace @piarium/desktop",
    "check": "npm run security:check && npm run format:check && npm run typecheck && npm run test",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "postinstall": "node scripts/repair-pi-shrinkwrap.mjs",
    "security:check": "node scripts/repair-pi-shrinkwrap.mjs --check",
    "smoke:extension": "npm run build && node scripts/smoke-extension.mjs",
    "smoke:desktop": "npm run smoke --workspace @piarium/desktop",
    "test": "npm run test --workspaces --if-present",
    "test:dist": "npm run test:dist --workspace @piarium/pi-host && npm run test:dist --workspace @piarium/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "brace-expansion": "5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
