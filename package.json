{
  "name": "piarium-monorepo",
  "version": "0.7.0",
  "description": "Pi-native desktop, web, mobile, and editor workspace for coding agents.",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "pi",
    "coding-agent",
    "ai",
    "coding",
    "piarium",
    "cli"
  ],
  "author": "Youzini-afk and Piarium contributors",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "node ./scripts/dev-web-hmr.mjs",
    "oc-dev": "node scripts/oc-dev.mjs",
    "build": "bun run --sequential --filter '!@piarium/mobile' build && bun run --cwd packages/mobile build:assets",
    "build:web": "bun run --cwd packages/extension-loader build && bun run --cwd packages/runtime-client build && bun run --cwd packages/web build",
    "build:cloud-runtime": "node scripts/build-cloud-runtime.mjs",
    "update:cloud-runtime-lock": "node scripts/build-cloud-runtime.mjs --skip-build --no-archive --update-lock",
    "build:ui": "bun run --cwd packages/ui build",
    "build:electron": "bun run --cwd packages/electron build",
    "build:mobile": "bun run --cwd packages/mobile build",
    "build:type-dependencies": "bun run --cwd packages/runtime-broker build && bun run --cwd packages/runtime-client build && bun run --cwd packages/extension-host build && bun run --cwd packages/extension-loader build",
    "type-check": "bun run build:type-dependencies && bun run --filter '*' type-check",
    "type-check:web": "bun run --cwd packages/web type-check",
    "type-check:ui": "bun run --cwd packages/ui type-check",
    "type-check:electron": "bun run --cwd packages/electron type-check",
    "type-check:mobile": "bun run --cwd packages/mobile type-check",
    "lint": "bun run --filter '*' lint",
    "lint:web": "bun run --cwd packages/web lint",
    "lint:ui": "bun run --cwd packages/ui lint",
    "lint:electron": "bun run --cwd packages/electron lint",
    "lint:mobile": "bun run --cwd packages/mobile lint",
    "clean": "bun run --filter '*' clean",
    "changelog-card": "node scripts/changelog-card/generate.mjs",
    "postinstall": "node ./scripts/fix-deprecation.js && patch-package && node ./packages/electron/scripts/ensure-electron.mjs --best-effort",
    "test:pi": "bun run --sequential --filter '@piarium/*' test",
    "test:pi:dist": "bun run --sequential --filter '@piarium/*' test:dist",
    "check:pi": "bun run build:type-dependencies && bun run --filter '@piarium/*' type-check && bun run test:pi",
    "test:cloud": "bunx vitest run scripts/cloud-runtime-layout.test.js scripts/cloud-remote-deploy.test.js scripts/docker-cloud-tools.test.js",
    "dev:web": "bun run --cwd packages/web build:watch",
    "dev:web:server": "bun run --cwd packages/web dev:server:watch",
    "dev:web:full": "node ./scripts/dev-web-full.mjs",
    "dev:web:hmr": "node ./scripts/dev-web-hmr.mjs",
    "start:web": "bun run --cwd packages/web start",
    "pack:web": "bun pm pack --cwd packages/web",
    "electron:dev": "node ./packages/electron/scripts/electron-dev.mjs",
    "electron:dev:bundled": "PIARIUM_ELECTRON_USE_BUNDLED_UI=1 node ./packages/electron/scripts/electron-dev.mjs",
    "electron:build": "bun run --cwd packages/electron package",
    "electron:build:win": "bun run --cwd packages/electron package:win:x64",
    "electron:smoke:win": "bun run --cwd packages/electron smoke:win:unpacked",
    "mobile:build": "bun run --cwd packages/mobile build",
    "mobile:sync": "bun run --cwd packages/mobile sync",
    "mobile:add:ios": "bun run --cwd packages/mobile add:ios",
    "mobile:add:android": "bun run --cwd packages/mobile add:android",
    "mobile:build:android:debug": "bun run --cwd packages/mobile build:android:debug",
    "mobile:build:ios:simulator": "bun run --cwd packages/mobile build:ios:simulator",
    "mobile:sim:boot": "bun run --cwd packages/mobile sim:boot",
    "mobile:sim:install": "bun run --cwd packages/mobile sim:install",
    "mobile:sim:launch": "bun run --cwd packages/mobile sim:launch",
    "mobile:sim:run": "bun run --cwd packages/mobile sim:run",
    "mobile:sim:dev": "bun run --cwd packages/mobile sim:dev",
    "mobile:sim:serve": "bun run --cwd packages/mobile sim:serve",
    "mobile:sim:list": "bun run --cwd packages/mobile sim:list",
    "mobile:sim:kill": "bun run --cwd packages/mobile sim:kill",
    "mobile:open:ios": "bun run --cwd packages/mobile open:ios",
    "mobile:open:android": "bun run --cwd packages/mobile open:android",
    "vscode:dev": "node ./scripts/dev-vscode.mjs",
    "vscode:build": "bun run --cwd packages/vscode build",
    "vscode:package": "bun run --cwd packages/vscode package",
    "vscode:type-check": "bun run --cwd packages/vscode type-check",
    "mobile:dev": "bun run --cwd packages/mobile dev",
    "mobile:ios": "bun run --cwd packages/mobile ios",
    "mobile:android": "bun run --cwd packages/mobile android",
    "mobile:prebuild": "bun run --cwd packages/mobile prebuild",
    "splash:emit": "bun run scripts/splash/emit-splash.ts",
    "docs:validate": "node scripts/docs/validate-docs.mjs",
    "test:docs": "node --test scripts/docs/engineering-docs.test.mjs",
    "dead-code": "bunx knip@5.80.0 --no-exit-code --include files,exports,nsExports,types,nsTypes,enumMembers,duplicates",
    "doctor": "node scripts/react-doctor.mjs",
    "profile:browser": "node scripts/profile-browser.mjs",
    "icons:sprite": "node scripts/generate-file-type-sprite.mjs",
    "themes:port:opencode": "tsx scripts/port-opencode-theme.ts",
    "version:bump": "node scripts/bump-version.mjs",
    "release:prepare": "bun run build && bun run type-check && bun run lint",
    "release:test": "./scripts/test-release-build.sh",
    "release:test:intel": "./scripts/test-release-build.sh x86_64",
    "release:test:arm": "./scripts/test-release-build.sh aarch64",
    "release:npm:prepare": "node scripts/npm-public-release.mjs prepare",
    "release:npm:verify": "node scripts/npm-public-release.mjs verify",
    "release:npm:test": "node --test scripts/npm-public-release.test.mjs && bun run --cwd packages/extension-contract test && bun run --cwd packages/extension-surface test && bun run --cwd packages/extension-sdk test && bun run --cwd packages/extension-cli test",
    "release:npm:build": "bun run --cwd packages/extension-contract build && bun run --cwd packages/extension-surface build && bun run --cwd packages/extension-sdk build && bun run --cwd packages/extension-react build && bun run --cwd packages/extension-cli build",
    "release:npm:package": "node scripts/npm-public-release.mjs package",
    "release:npm:publish": "node scripts/npm-public-release.mjs publish"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "6.12.2",
    "@codemirror/lint": "6.9.5",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "6.39.13",
    "@heroui/scroll-shadow": "^2.3.19",
    "@heroui/system": "^2.4.28",
    "@heroui/theme": "^2.4.26",
    "@lezer/highlight": "^1.2.3",
    "@octokit/rest": "^22.0.1",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-virtual": "3.14.5",
    "@xenova/transformers": "^2.17.2",
    "@zumer/snapdom": "^2.23.1",
    "bun-pty": "^0.4.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "express": "^5.2.1",
    "ghostty-web": "0.4.0",
    "http-proxy-middleware": "^3.0.7",
    "next-themes": "^0.4.6",
    "node-pty": "1.2.0-beta.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.36.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-systemjs": "7.29.8",
    "@codemirror/language": "6.12.2",
    "@codemirror/lint": "6.9.5",
    "@codemirror/state": "6.5.4",
    "@codemirror/view": "6.39.13",
    "@tootallnate/once": "2.0.1",
    "adm-zip": "0.6.0",
    "app-builder-lib": "26.15.7",
    "body-parser": "2.3.0",
    "builder-util-runtime": "9.7.0",
    "dompurify": "3.4.13",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.5",
    "flatted": "3.4.4",
    "follow-redirects": "1.16.0",
    "form-data": "4.0.6",
    "ip-address": "10.4.0",
    "js-yaml": "4.3.1",
    "linkify-it": "5.0.2",
    "lodash": "4.18.1",
    "markdown-it": "14.3.0",
    "nanoid": "5.1.16",
    "node-abi": "4.33.0",
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.5",
    "postcss": "8.5.25",
    "protobufjs": "7.6.5",
    "qs": "6.15.3",
    "serialize-javascript": "7.0.7",
    "sharp": "0.35.3",
    "shell-quote": "1.10.0",
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "vite": "7.3.6",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.10.0",
    "node-addon-api": "7.1.1",
    "nodemon": "^3.1.14",
    "patch-package": "^8.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "typescript-language-server": "^5.3.0",
    "vite": "^7.3.6"
  },
  "patchedDependencies": {
    "@tanstack/virtual-core@3.17.3": "bun-patches/@tanstack+virtual-core+3.17.3.patch"
  }
}
