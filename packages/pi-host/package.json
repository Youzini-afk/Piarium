{
  "name": "@piarium/pi-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isolated Node host for Piarium's Pi SDK runtime.",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "piarium-host": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./discovery": {
      "types": "./dist/runtime-discovery.d.ts",
      "import": "./dist/runtime-discovery.js"
    },
    "./host": "./dist/main.js"
  },
  "scripts": {
    "build": "bun run build:dependencies && tsc -p tsconfig.build.json",
    "build:dependencies": "bun run --cwd ../protocol build && bun run --cwd ../recovery build",
    "lint": "eslint \"./src/**/*.ts\" --config ../../eslint.config.js",
    "test": "tsx --test test/**/*.test.ts",
    "test:dist": "bun run build && node --test test/dist-smoke.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@piarium/protocol": "0.1.0",
    "@piarium/recovery": "0.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
