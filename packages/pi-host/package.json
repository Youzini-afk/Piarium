{
  "name": "@piarium/pi-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isolated Node host for Piarium's Pi SDK runtime.",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "piarium-host": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./discovery": {
      "types": "./dist/runtime-discovery.d.ts",
      "import": "./dist/runtime-discovery.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test test/**/*.test.ts",
    "test:dist": "node --test test/dist-smoke.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@piarium/protocol": "0.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
