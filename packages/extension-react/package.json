{
  "name": "@piarium/extension-react",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Optional React 19 adapter for Piarium Surface extensions.",
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Youzini-afk/Piarium.git",
    "directory": "packages/extension-react"
  },
  "homepage": "https://github.com/Youzini-afk/Piarium/tree/main/packages/extension-react",
  "bugs": "https://github.com/Youzini-afk/Piarium/issues",
  "publishConfig": { "access": "public" },
  "sideEffects": false,
  "scripts": {
    "build:dependencies": "bun run --cwd ../extension-sdk build",
    "build": "bun run build:dependencies && tsc -p tsconfig.build.json",
    "lint": "eslint \"./src/**/*.ts\" --config ../../eslint.config.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": { "@piarium/extension-sdk": "0.1.0" },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
