{
  "name": "@piarium/electron",
  "version": "0.9.9",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Piarium desktop runtime",
  "author": "Youzini-afk and Piarium contributors",
  "type": "module",
  "main": "./dist-bundle/main.mjs",
  "dependencies": {
    "@piarium/application-client": "workspace:*",
    "@piarium/web": "workspace:*",
    "@piarium/pi-host": "workspace:*",
    "@piarium/protocol": "workspace:*",
    "@piarium/runtime-broker": "workspace:*",
    "@piarium/settings-store": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "electron-context-menu": "^4.1.2",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.9",
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.7",
    "node-abi": "^4.33.0"
  },
  "trustedDependencies": [
    "electron"
  ],
  "desktopPrerequisites": [
    "Electron runtime dependencies installed via bun install",
    "Bun available for sidecar compilation",
    "macOS: Xcode + build tools for notarized packaging",
    "Windows: electron-builder/NSIS packaging on a Windows runner; code signing is optional when signing env vars are absent",
    "Linux: native x64 or arm64 host (no cross-arch packaging); FUSE/libfuse2 to run AppImages, or APPIMAGE_EXTRACT_AND_RUN=1"
  ],
  "scripts": {
    "dev": "node ./scripts/electron-dev.mjs",
    "ensure:electron": "node ./scripts/ensure-electron.mjs",
    "build:web-assets": "node ./scripts/build-web-assets.mjs",
    "build": "bun run bundle:main",
    "prepare:type-check": "bun run --cwd ../web prepare:application-host && bun run --cwd ../web build:application-host:types",
    "prepare:pi-runtime": "bun run --cwd ../settings-store build && bun run --cwd ../runtime-broker build && bun run --cwd ../extension-host build",
    "verify:linux-appimage": "node ./scripts/verify-linux-appimage.mjs",
    "bundle:main": "bun ./scripts/bundle-main.mjs",
    "generate:macos-icon": "node ./scripts/generate-macos-icon-assets.cjs",
    "rebuild:native": "node ./scripts/rebuild-native.mjs",
    "smoke:desktop:unpacked": "node ./scripts/smoke-desktop-unpacked.mjs",
    "smoke:win:unpacked": "node ./scripts/smoke-windows-unpacked.mjs",
    "test:runtime": "vitest run --config vitest.config.ts",
    "test:architecture": "bun run prepare:pi-runtime && bun run test:runtime && node --test ./scripts/commit-web-asset-generation.test.mjs ./scripts/dev-server-runtime.test.mjs ./scripts/target-architecture.test.mjs ./scripts/windows-installer-config.test.mjs ./scripts/verify-linux-appimage.test.mjs ./scripts/verify-update-manifest.test.mjs",
    "test:updater": "vitest run updater-capability.test.ts updater-channel.test.ts updater-check.test.ts updater-feed.test.ts --config vitest.config.ts && node --test ./scripts/finalize-latest-yml.test.mjs ./scripts/updater-e2e-fixture.test.mjs",
    "test:linux-desktop": "vitest run linux-autostart.test.ts --config vitest.config.ts && tsx ./scripts/smoke-linux-app-discovery.mjs && tsx ./scripts/smoke-path-open-utils.mjs",
    "updater:e2e:fixture": "node ./scripts/updater-e2e-fixture.mjs",
    "verify:update-manifest": "node ./scripts/verify-update-manifest.mjs",
    "package": "bun run build:web-assets && bun run prepare:pi-runtime && bun run bundle:main && bun run rebuild:native && node ./scripts/package.mjs",
    "package:win:x64": "bun run build:web-assets && bun run prepare:pi-runtime && bun run bundle:main && bun run rebuild:native && node ./scripts/package.mjs --win --x64 --publish=never",
    "finalize:latest-yml": "node ./scripts/finalize-latest-yml.mjs",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint \"./*.ts\" --config ../../eslint.config.js"
  },
  "build": {
    "appId": "dev.piarium.desktop",
    "productName": "Piarium",
    "files": [
      "dist-bundle/main.mjs",
      "dist-bundle/preload.mjs"
    ],
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "electronLanguages": [
      "en-US",
      "es",
      "fr",
      "ja",
      "ko",
      "pl",
      "pt-BR",
      "uk",
      "zh-CN",
      "zh-TW"
    ],
    "extraResources": [
      {
        "from": "resources/web-dist",
        "to": "web-dist"
      },
      {
        "from": "resources/icons/icon.ico",
        "to": "icons/icon.ico"
      },
      {
        "from": "resources/icons/icon.png",
        "to": "icons/icon.png"
      },
      {
        "from": "resources/icons/tray",
        "to": "icons/tray"
      },
      {
        "from": "../../LICENSE",
        "to": "legal/LICENSE"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "legal/THIRD_PARTY_NOTICES.md"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "buildResources": "resources/icons",
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icons/icon.icns",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "CFBundleIconName": "AppIcon"
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/icons/icon.ico",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": false,
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "resources/icons/icon.png",
      "executableName": "piarium",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Piarium",
          "Comment": "Pi-native coding workspace",
          "Icon": "piarium",
          "StartupWMClass": "piarium"
        }
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "include": "resources/installer.nsh",
      "installerIcon": "resources/icons/icon.ico",
      "uninstallerIcon": "resources/icons/icon.ico",
      "installerHeaderIcon": "resources/icons/icon.ico"
    },
    "dmg": {
      "sign": true,
      "title": "${productName} ${version}",
      "backgroundColor": "#FFFCF0",
      "iconSize": 100,
      "iconTextSize": 13,
      "window": {
        "width": 540,
        "height": 340
      },
      "contents": [
        {
          "x": 180,
          "y": 140,
          "type": "file"
        },
        {
          "x": 360,
          "y": 140,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "Youzini-afk",
      "repo": "Piarium"
    }
  }
}
