{
  "name": "piarium",
  "displayName": "Piarium",
  "description": "%extension.description%",
  "version": "0.9.8",
  "publisher": "youzini-afk",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Youzini-afk/Piarium.git"
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "claude",
    "gpt",
    "agent",
    "coding",
    "chatgpt",
    "groq",
    "assistant",
    "pi",
    "piarium"
  ],
  "icon": "assets/app-icon.png",
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onCommand:piarium.openSidebar",
    "onCommand:piarium.attachExplorerToChat",
    "onView:piarium.chatView",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "piarium",
          "title": "Piarium",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "piarium": [
        {
          "type": "webview",
          "id": "piarium.chatView",
          "name": "%views.chat.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "piarium.openSidebar",
        "category": "Piarium",
        "title": "%command.openSidebar.title%",
        "icon": {
          "light": "assets/icon.svg",
          "dark": "assets/icon-titlebar.svg"
        }
      },
      {
        "command": "piarium.focusChat",
        "category": "Piarium",
        "title": "%command.focusChat.title%"
      },
      {
        "command": "piarium.restartRuntime",
        "category": "Piarium",
        "title": "%command.restartRuntime.title%"
      },
      {
        "command": "piarium.showRuntimeStatus",
        "category": "Piarium",
        "title": "%command.showRuntimeStatus.title%"
      },
      {
        "command": "piarium.openAgentManager",
        "category": "Piarium",
        "title": "%command.openAgentManager.title%",
        "icon": "$(circuit-board)"
      },
      {
        "command": "piarium.openActiveSessionInEditor",
        "category": "Piarium",
        "title": "%command.openActiveSessionInEditor.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "piarium.openNewSessionInEditor",
        "category": "Piarium",
        "title": "%command.openNewSessionInEditor.title%",
        "icon": {
          "light": "assets/icon.svg",
          "dark": "assets/icon-titlebar.svg"
        }
      },
      {
        "command": "piarium.openCurrentOrNewSessionInEditor",
        "category": "Piarium",
        "title": "%command.openCurrentOrNewSessionInEditor.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "piarium.addToContext",
        "category": "Piarium",
        "title": "%command.addToContext.title%"
      },
      {
        "command": "piarium.explain",
        "category": "Piarium",
        "title": "%command.explain.title%"
      },
      {
        "command": "piarium.improveCode",
        "category": "Piarium",
        "title": "%command.improveCode.title%"
      },
      {
        "command": "piarium.newSession",
        "category": "Piarium",
        "title": "%command.newSession.title%",
        "icon": "$(add)"
      },
      {
        "command": "piarium.showSettings",
        "category": "Piarium",
        "title": "%command.showSettings.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "piarium.attachExplorerToChat",
        "category": "Piarium",
        "title": "%command.attachExplorerToChat.title%"
      }
    ],
    "submenus": [
      {
        "id": "piarium.submenu",
        "label": "Piarium"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "piarium.submenu",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "piarium.attachExplorerToChat",
          "when": "resourceScheme == file && explorerResourceIsFolder == false",
          "group": "navigation@50"
        }
      ],
      "editor/title": [
        {
          "command": "piarium.newSession",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "piarium.newSession",
          "when": "view == piarium.chatView",
          "group": "navigation@1"
        },
        {
          "command": "piarium.openAgentManager",
          "when": "view == piarium.chatView",
          "group": "navigation@2"
        },
        {
          "command": "piarium.showSettings",
          "when": "view == piarium.chatView",
          "group": "navigation@3"
        }
      ],
      "piarium.submenu": [
        {
          "command": "piarium.explain"
        },
        {
          "command": "piarium.improveCode"
        },
        {
          "command": "piarium.addToContext"
        }
      ]
    },
    "configuration": {
      "title": "Piarium",
      "properties": {
        "piarium.nodePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%configuration.nodePath.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run build",
    "build": "bun run prepare:pi-runtime && bun run prepare:extension-host && bun run build:extension && bun run build:webview",
    "prepare:pi-runtime": "bun run --cwd ../runtime-broker build && node scripts/prepare-pi-runtime.mjs",
    "prepare:extension-host": "bun run --cwd ../extension-host build && bun run --cwd ../extension-loader build && node scripts/prepare-extension-host.mjs",
    "test:pi-runtime": "node scripts/test-pi-runtime.mjs",
    "verify:pi-runtime": "bun run prepare:pi-runtime && bun run test:pi-runtime",
    "build:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:esbuild --format=cjs --platform=node --minify --main-fields=module,main",
    "build:webview": "vite build",
    "dev": "concurrently -n \"ext,web\" -c \"cyan,magenta\" \"bun run watch:extension\" \"bun run dev:webview\"",
    "dev:webview": "vite --host localhost --port 5173 --strictPort",
    "watch:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:esbuild --format=cjs --platform=node --watch --sourcemap --main-fields=module,main",
    "watch:webview": "vite build --watch",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "lint": "bun x eslint --ext .ts,.tsx src webview",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "1.85.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vscode/vsce": "^3.9.2",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.2"
  },
  "dependencies": {
    "@piarium/extension-contract": "workspace:*",
    "@piarium/extension-host": "workspace:*",
    "@piarium/ui": "workspace:*",
    "@piarium/protocol": "workspace:*",
    "@piarium/runtime-broker": "workspace:*",
    "@piarium/runtime-client": "workspace:*",
    "@piarium/settings-store": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
