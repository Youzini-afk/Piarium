{
  "name": "@piarium/runtime-broker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trusted Pi worker lifecycle and request broker for Piarium surfaces.",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "scripts": {
    "build:dependencies": "bun run --cwd ../protocol build && bun run --cwd ../pi-host build",
    "build": "bun run build:dependencies && tsc -p tsconfig.build.json",
    "lint": "eslint \"./src/**/*.ts\" --config ../../eslint.config.js",
    "test": "tsx --test test/**/*.test.ts",
    "test:dist": "bun run build && node --test test/dist-smoke.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@piarium/pi-host": "0.1.0",
    "@piarium/protocol": "0.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
