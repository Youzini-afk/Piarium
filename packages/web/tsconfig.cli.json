{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": false,
    "rootDir": "cli",
    "outDir": ".cli-build",
    "types": ["node"],
    "sourceMap": true,
    "declaration": false,
    "noEmit": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@varin/protocol": ["./node_modules/@varin/protocol/dist/index.d.ts"],
      "@varin/settings-store": ["./node_modules/@varin/settings-store/dist/index.d.ts"],
      "#application-host/*": [
        "./packages/web/.application-host-types/*",
        "./packages/web/server/*"
      ]
    }
  },
  "include": ["cli/**/*.ts"],
  "exclude": ["cli/**/*.test.ts"]
}
