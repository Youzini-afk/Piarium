{
  "name": "@piarium/web",
  "version": "0.8.0",
  "license": "AGPL-3.0-only",
  "private": false,
  "type": "module",
  "main": "./server/index.js",
  "types": "./server/index.d.ts",
  "bin": {
    "piarium": "./bin/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run build:watch",
    "dev:server": "bun run prepare:pi-runtime && bun server/index.js",
    "dev:server:watch": "bun run prepare:pi-runtime && nodemon --watch server --ext js --exec \"bun server/index.js\"",
    "build": "bun run --cwd ../extension-builtins build && vite build",
    "build:watch": "vite build --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"./src/**/*.{ts,tsx}\" --config ../../eslint.config.js",
    "test": "vitest run",
    "prepare:pi-runtime": "bun run --cwd ../runtime-broker build && bun run --cwd ../extension-host build",
    "start": "bun run prepare:pi-runtime && node bin/cli.js serve"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@konbakuyomu/smart-search": "^0.1.14",
    "@octokit/rest": "^22.0.1",
    "@piarium/extension-contract": "workspace:*",
    "@piarium/extension-host": "workspace:*",
    "@piarium/protocol": "workspace:*",
    "@piarium/runtime-broker": "workspace:*",
    "@piarium/settings-store": "workspace:*",
    "@simplewebauthn/server": "13.3.2",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "bun-pty": "^0.4.5",
    "compression": "^1.8.1",
    "cron-parser": "^4.9.0",
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.5",
    "jose": "^6.1.3",
    "jsonc-parser": "^3.3.1",
    "luxon": "^3.5.0",
    "multer": "^2.1.1",
    "node-pty": "1.2.0-beta.12",
    "openai": "^4.79.0",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "^0.2.2",
    "ripgrep": "^0.3.1",
    "sherpa-onnx-node": "1.12.28",
    "simple-git": "^3.28.0",
    "tar": "^7.5.13",
    "web-push": "^3.6.7",
    "ws": "^8.18.3",
    "yaml": "^2.8.1",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "@piarium/ui": "workspace:*",
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.0",
    "vite": "^7.1.2",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.0"
  },
  "files": [
    "dist",
    "server",
    "bin",
    "public",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "package.json",
    "README.md"
  ]
}
