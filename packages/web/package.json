{
  "name": "@piarium/web",
  "version": "0.9.9",
  "license": "AGPL-3.0-only",
  "private": false,
  "type": "module",
  "main": "./server/index.js",
  "types": "./server/index.d.ts",
  "bin": {
    "piarium": "./bin/cli.js"
  },
  "imports": {
    "#application-host/*": "./server/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "bun run build:watch",
    "dev:server": "bun run build:application-host && node server/index.js",
    "dev:server:watch": "bun run prepare:application-host && nodemon --exitcrash --watch application-host --ext js,ts --exec \"bun run build:application-host:raw && node server/index.js\"",
    "prepare:application-host": "bun run --cwd ../application-client build && bun run --cwd ../runtime-broker build && bun run --cwd ../extension-host build",
    "build:application-host:raw": "node scripts/build-application-host.mjs",
    "build:application-host:types": "node scripts/build-application-host-types.mjs",
    "build:application-host": "bun run prepare:application-host && bun run build:application-host:raw",
    "build:cli:raw": "node scripts/build-cli.mjs",
    "build:cli": "bun run build:application-host && bun run build:cli:raw",
    "build": "bun run build:application-host && bun run build:cli:raw && bun run --cwd ../extension-builtins build && vite build",
    "build:monaco-smoke": "cross-env PIARIUM_MONACO_SMOKE=1 PIARIUM_MONACO_BUNDLE_AUDIT=1 bun run build && node scripts/verify-monaco-bundle.mjs",
    "build:watch": "vite build --watch",
    "type-check": "tsc --noEmit && bun run type-check:application-host && bun run type-check:cli:raw",
    "type-check:application-host:tests": "tsc --noEmit -p tsconfig.application-host.tests.json",
    "type-check:application-host:raw": "bun run build:application-host:types && bun run type-check:application-host:tests",
    "type-check:application-host": "bun run prepare:application-host && bun run type-check:application-host:raw",
    "type-check:cli:source": "tsc --noEmit -p tsconfig.cli.json",
    "type-check:cli:tests": "tsc --noEmit -p tsconfig.cli.tests.json",
    "type-check:cli:raw": "bun run type-check:cli:source && bun run type-check:cli:tests",
    "lint": "eslint \"./src/**/*.{ts,tsx}\" \"./application-host/**/*.ts\" \"./cli/**/*.ts\" --config ../../eslint.config.js",
    "test": "vitest run",
    "test:node-smoke": "bun run build:application-host && node --test application-host/lib/knowledge/store.smoke.test.ts",
    "prepare:pi-runtime": "bun run prepare:application-host",
    "start": "bun run build:cli && node bin/cli.js serve",
    "clean": "node scripts/build-application-host.mjs --clean && node scripts/build-cli.mjs --clean"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@konbakuyomu/smart-search": "^0.1.14",
    "@mozilla/readability": "0.6.0",
    "@octokit/rest": "^22.0.1",
    "@piarium/application-client": "workspace:*",
    "@piarium/extension-contract": "workspace:*",
    "@piarium/extension-host": "workspace:*",
    "@piarium/protocol": "workspace:*",
    "@piarium/runtime-broker": "workspace:*",
    "@piarium/settings-store": "workspace:*",
    "@simplewebauthn/server": "13.3.2",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "bun-pty": "^0.4.5",
    "compression": "^1.8.1",
    "cron-parser": "^4.9.0",
    "diff": "9.0.0",
    "express": "^5.1.0",
    "http-proxy-middleware": "^4.2.0",
    "ignore": "7.0.5",
    "jose": "^6.1.3",
    "jsonc-parser": "^3.3.1",
    "linkedom": "0.18.13",
    "luxon": "^3.5.0",
    "multer": "^2.3.0",
    "node-pty": "1.2.0-beta.15",
    "openai": "^4.79.0",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "^0.2.2",
    "ripgrep": "^0.3.1",
    "sherpa-onnx-node": "1.12.28",
    "simple-git": "^3.28.0",
    "tar": "^7.5.13",
    "triviumdb": "0.8.5",
    "turndown": "7.2.4",
    "web-push": "^3.6.7",
    "ws": "^8.18.3",
    "yaml": "^2.8.1",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@piarium/extension-builtins": "workspace:*",
    "@piarium/ui": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.7.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^7.2.1",
    "@types/turndown": "5.0.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.0",
    "vite": "^7.1.2",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.0"
  },
  "files": [
    "dist",
    "server",
    "bin",
    "public",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "package.json",
    "README.md"
  ]
}
