{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piarium.dev/schemas/piarium.discovery-catalog.v1.json",
  "title": "Piarium Extension Discovery Catalog",
  "type": "object",
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "homepage": { "type": "string", "minLength": 1 },
          "icon": { "type": "string", "minLength": 1 },
          "keywords": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "source": {
            "type": "object",
            "required": ["display", "kind", "specifier"],
            "properties": {
              "display": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["builtin", "git", "local", "npm"] },
              "specifier": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
