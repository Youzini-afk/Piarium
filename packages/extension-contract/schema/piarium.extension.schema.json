{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piarium.dev/schemas/piarium.extension.v1.json",
  "title": "Piarium Extension Manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "engines"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "displayName": { "$ref": "#/$defs/text" },
    "version": { "$ref": "#/$defs/semver" },
    "engines": {
      "type": "object",
      "required": ["piarium"],
      "properties": { "piarium": { "$ref": "#/$defs/semverRange" } }
    },
    "entrypoints": {
      "type": "object",
      "properties": {
        "host": {
          "type": "object",
          "required": ["file", "mode"],
          "properties": {
            "file": { "$ref": "#/$defs/entryPath" },
            "mode": { "enum": ["brokered", "native"] },
            "activation": { "$ref": "#/$defs/activationList" }
          }
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "mode", "supports"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "file": { "$ref": "#/$defs/entryPath" },
              "mode": { "enum": ["declarative", "isolated", "managed", "native"] },
              "isolation": { "enum": ["iframe", "worker"] },
              "supports": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/surface" }
              },
              "activation": { "$ref": "#/$defs/activationList" }
            },
            "allOf": [
              {
                "if": { "properties": { "mode": { "const": "isolated" } }, "required": ["mode"] },
                "else": { "not": { "required": ["isolation"] } }
              }
            ]
          }
        }
      }
    },
    "requires": {
      "type": "object",
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/service" },
              {
                "type": "object",
                "properties": {
                  "optional": { "type": "boolean" },
                  "binding": { "enum": ["all", "selected", "single"] }
                }
              }
            ]
          }
        }
      }
    },
    "provides": {
      "type": "object",
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/service" },
              { "type": "object", "properties": { "multiple": { "type": "boolean" } } }
            ]
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "host": { "$ref": "#/$defs/idList" },
        "surface": { "$ref": "#/$defs/idList" }
      }
    },
    "integrates": {
      "type": "object",
      "properties": {
        "piPackages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "description": { "$ref": "#/$defs/text" },
        "homepage": { "$ref": "#/$defs/text" },
        "repository": { "$ref": "#/$defs/text" },
        "icon": { "$ref": "#/$defs/entryPath" },
        "keywords": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        }
      }
    },
    "storage": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": { "schemaVersion": { "type": "integer", "minimum": 1 } }
    },
    "contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["contractVersion", "data", "id", "kind", "supports"],
        "properties": {
          "contractVersion": { "type": "integer", "minimum": 1 },
          "data": { "type": "object" },
          "entrypoint": { "$ref": "#/$defs/id" },
          "id": { "$ref": "#/$defs/id" },
          "kind": {
            "enum": [
              "command", "composer-action", "keybinding", "menu-item", "message-renderer",
              "page", "panel", "session-decoration", "settings-page", "shell", "sidebar",
              "status-item", "tool-renderer"
            ]
          },
          "supports": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/surface" }
          },
          "title": { "$ref": "#/$defs/text" },
          "when": { "$ref": "#/$defs/text" },
          "requiresCapabilities": { "$ref": "#/$defs/idList" },
          "placement": {
            "type": "object",
            "properties": {
              "slot": { "$ref": "#/$defs/id" },
              "order": { "type": "number" },
              "before": { "$ref": "#/$defs/idList" },
              "after": { "$ref": "#/$defs/idList" }
            }
          },
          "replacement": {
            "type": "object",
            "required": ["target"],
            "properties": {
              "target": { "$ref": "#/$defs/id" },
              "priority": { "type": "number" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "activationList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "application-startup", "background", "command", "contribution-visible",
          "service-request", "workspace-match"
        ]
      }
    },
    "entryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "semverRange": {
      "type": "string",
      "minLength": 1,
      "format": "semver-range"
    },
    "service": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "surface": { "enum": ["desktop", "mobile", "vscode", "web"] },
    "text": { "type": "string", "minLength": 1 }
  }
}
