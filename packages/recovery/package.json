{
  "name": "@piarium/recovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Transactional conversation and workspace recovery for Piarium.",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@piarium/protocol": "0.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
