{
  "name": "@piarium/extension-surface",
  "version": "0.2.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Framework-neutral owner scopes and transactional Surface registries for Piarium extensions.",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Youzini-afk/Piarium.git",
    "directory": "packages/extension-surface"
  },
  "homepage": "https://github.com/Youzini-afk/Piarium/tree/main/packages/extension-surface",
  "bugs": "https://github.com/Youzini-afk/Piarium/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build:dependencies": "bun run --cwd ../extension-contract build",
    "build": "bun run build:dependencies && tsc -p tsconfig.build.json",
    "lint": "eslint \"./src/**/*.ts\" --config ../../eslint.config.js",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@piarium/extension-contract": "0.2.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
