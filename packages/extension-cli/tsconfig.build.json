{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "outDir": "dist",
    "paths": {
      "@varin/extension-contract": ["packages/extension-contract/dist/index.d.ts"],
      "@varin/extension-sdk": ["packages/extension-sdk/dist/index.d.ts"],
      "@varin/extension-sdk/testing": ["packages/extension-sdk/dist/testing.d.ts"],
      "@varin/extension-surface": ["packages/extension-surface/dist/index.d.ts"]
    },
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test"]
}
